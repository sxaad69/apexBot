[Unit]
Description=Apex Daily Settlement Audit (Forensics)
After=network.target

[Service]
# User should replace 'ubuntu' with their actual username if different
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apexBot
EnvironmentFile=/home/ubuntu/apexBot/.env
# Run all three audit modes and write a permanent daily JSON report.
# Window is computed inside the tool (defaults to the previous UTC day).
ExecStart=/home/ubuntu/apexBot/venv/bin/python3 audit/apex_forensics.py --settle
Restart=on-failure
RestartSec=30
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=apex-forensics

[Install]
WantedBy=multi-user.target
