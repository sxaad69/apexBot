# ===== Apex Hunter V14 - environment template =====
# This is the ONLY file that must be configured on a new host.
# Copy to .env, fill in the four secret fields, and run.
# Everything else lives as committed defaults in config/config.py.
#
# Environment (which exchange / mode this host runs)
EXCHANGE=binance
TRADING_MODE=live
FUTURES_EXCHANGE=binance
SPOT_EXCHANGE=binance
EXCHANGE_ENVIRONMENT=production

# Exchange API credentials (SECRET - never commit real values)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram credentials (SECRET - never commit real values)
TELEGRAM_BOT_TOKEN=
TELEGRAM_FUTURES_BOT_TOKEN=
TELEGRAM_USER_ID=8528475044
TELEGRAM_FUTURES_CHAT_ID=8528475044