[Unit]
Description=Apex Hunter V14 Trading Bot
After=network.target

[Service]
# User should replace 'ubuntu' with their actual username if different
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apexBot
EnvironmentFile=/home/ubuntu/apexBot/.env
# Pass --mode live to enable live trading. Change to 'paper' for simulation.
# APEX_CONFIRM_LIVE=YES bypasses the interactive confirmation prompt for AWS headless mode.
Environment=APEX_CONFIRM_LIVE=YES
ExecStart=/home/ubuntu/apexBot/venv/bin/python3 main.py --interval 10
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=apex-bot

[Install]
WantedBy=multi-user.target
