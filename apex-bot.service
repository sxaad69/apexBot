[Unit]
Description=Apex Hunter V14 Trading Bot
After=network.target

[Service]
# User should replace 'ubuntu' with their actual username if different
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apexBot
EnvironmentFile=/home/ubuntu/apexBot/.env
# Pass --mode live to enable live trading. Change to 'paper' for simulation.
# APEX_CONFIRM_LIVE=YES bypasses the interactive confirmation prompt for AWS headless mode.
Environment=APEX_CONFIRM_LIVE=YES
# Python 3.14 datetime.utcnow() DeprecationWarnings firehose stderr on every DB write
# (~2 journal lines per log event) — churns the 4h journald ring and wastes disk (89% full).
Environment=PYTHONWARNINGS=ignore::DeprecationWarning
ExecStart=/home/ubuntu/apexBot/venv/bin/python3 main.py --interval 30
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=apex-bot

[Install]
WantedBy=multi-user.target
